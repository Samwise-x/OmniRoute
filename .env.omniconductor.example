# Copy to .env.omniconductor (or export the variables before Compose).
# Generate a random secret: openssl rand -hex 32
CONDUCTOR_HUB_TOKEN=replace-with-at-least-32-random-bytes
CONDUCTOR_HUB_BIND=127.0.0.1
CONDUCTOR_FARO_BIND=127.0.0.1
RUNNER_REPLICAS=2
RUNNER_NAME=omni-runner
RUNNER_CLIS=claude,codex,opencode
# Comma-separated allowed model names or * to delegate validation to the selected CLI.
RUNNER_MODELS=*
# Optional per-harness overrides (comma-separated); these override RUNNER_MODELS.
RUNNER_CLAUDE_MODELS=
RUNNER_CODEX_MODELS=
RUNNER_OPENCODE_MODELS=
RUNNER_GATEWAY_MODELS=
RUNNER_MAX_CONCURRENCY=1
RUNNER_TASK_TIMEOUT_MS=1200000
RUNNER_TEST_TIMEOUT_MS=300000
# Optional explicit JSON argv (example: ["npm","test"]); otherwise auto-detects tests.
RUNNER_TEST_COMMAND=
RUNNER_HEARTBEAT_TTL_MS=90000
# Optional: limit HTTPS clone hosts (comma-separated exact DNS names).
RUNNER_ALLOWED_REPO_HOSTS=
# Optional host-scoped read token for private HTTPS clones. Passed only to git clone.
RUNNER_GIT_HOST=github.com
RUNNER_GIT_TOKEN=
# Optional custom Gateway-compatible executable (must exist in the runner image).
GATEWAY_BIN=
# Harness credentials. Never commit actual values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional OmniRoute endpoint for a harness/provider configured to use it.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# Optional Faro chat model routed through the OmniRoute OpenAI-compatible API.
FARO_MODEL=
